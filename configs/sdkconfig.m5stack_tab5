# M5Stack Tab5 profile: ESP32-P4 host + onboard ESP32-C6 radio.
# The P4 runs the application, display and UI; the onboard C6 supplies 2.4 GHz
# Wi-Fi and BLE over ESP-Hosted SDIO (same architecture as the CrowPanel
# Advanced P4). Display: ILI9881C 720x1280 two-lane MIPI-DSI, GT911 touch, two
# PI4IOE5V6408 I/O expanders, LEDC backlight on GPIO22. Native portrait for now
# (landscape rotation is a follow-up). Add an ESP32-C5 over GhostLink for 5 GHz.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BUILD_CONFIG_TEMPLATE="M5Stack Tab5"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

CONFIG_WITH_SCREEN=y
CONFIG_TFT_WIDTH=720
CONFIG_TFT_HEIGHT=1280
CONFIG_USE_TOUCHSCREEN=y
CONFIG_M5STACK_TAB5=y
CONFIG_M5STACK_TAB5_PANEL_ILI9881C=y
CONFIG_VFS_MAX_COUNT=16
CONFIG_GHOSTESP_P4_PPA_RENDER=y

CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_COLOR_16_SWAP is not set
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_TOUCH_CONTROLLER_GT911=y
# GT911 lands at its 0x5D primary address: tab5_display_touch_reset() holds INT
# (GPIO23) low across the TP_RST release. RESET/INT are on the IO-expander, so
# the lvgl GT911 driver drives neither pin directly.
# CONFIG_LV_GT911_SWAPXY is not set
# CONFIG_LV_GT911_INVERT_X is not set
# CONFIG_LV_GT911_INVERT_Y is not set
CONFIG_USING_MMC_1_BIT=y
CONFIG_SD_MMC_CLK=43
CONFIG_SD_MMC_CMD=44
CONFIG_SD_MMC_D0=39
CONFIG_LV_I2C_TOUCH=y
CONFIG_LV_I2C_TOUCH_PORT_0=y
CONFIG_LV_I2C_TOUCH_PORT=0
CONFIG_I2C_MANAGER_0_ENABLED=y
CONFIG_I2C_MANAGER_0_SDA=31
CONFIG_I2C_MANAGER_0_SCL=32
CONFIG_I2C_MANAGER_0_FREQ_HZ=400000
CONFIG_I2C_MANAGER_0_TIMEOUT=100
CONFIG_I2C_MANAGER_0_LOCK_TIMEOUT=50
CONFIG_I2C_MANAGER_0_PULLUPS=y

# Tab5 PSRAM (octal HEX @200 MHz). These are also the ESP32-P4 defaults; set
# explicitly so a Launcher/direct flash always configures PSRAM correctly.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_FREERTOS_HZ=1000
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
# CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM is not set

# P4 TLS: accept valid cross-signed chains used by the Cloud Store/CDN.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set

# Backlight: LEDC PWM on GPIO22. tab5_display.c owns the LEDC init/duty; these
# keep the shared backlight plumbing consistent.
CONFIG_LV_DISP_BACKLIGHT_PWM=y
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y
CONFIG_LV_DISP_PIN_BCKL=22

# The P4 has no local BT controller; the onboard C6 supplies it over the
# ESP-Hosted NimBLE VHCI bridge.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_HAS_BADBLE=y
# CONFIG_NFC_CHAMELEON is not set

# ESP-Hosted SDIO wiring to the onboard C6 (Tab5 host pins; C6-side pins are
# fixed by C6 silicon so the bundled network_adapter.bin is reused unchanged).
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_PRIV_SPI_HD_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PIN_D1=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=15

# ESP-Hosted P4+C6 Wi-Fi buffer defaults (same as CrowPanel P4).
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_m5stack_tab5.csv"
CONFIG_M5STACK_TAB5_KEYBOARD=y
CONFIG_JANOS_USB=y
